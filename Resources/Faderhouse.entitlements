<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Entitlements for the Developer ID (signed + notarized) build of Faderhouse.app.
  Notarization requires the hardened runtime, which by default blocks a few things
  Faderhouse needs:
    - audio-input:              the microphone channel (audio interface input)
    - disable-library-validation: loading third-party VST3/AU plugins, which are signed
                                by other developers (or not signed at all)
-->
<plist version="1.0">
<dict>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
